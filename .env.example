# Copy this file to .env at the repository root, then fill in the real values.
# Both the Python pipeline (ingestion/db.py) and the Node API (api/src/db.ts)
# read this one file, so the two layers always target the same database.

# The compose service maps host port 5544 to container port 5432, because a
# native Postgres already owns 5432 on the development machine. If you change
# the host port, change it in docker-compose.yml, ingestion/db.py and
# api/src/db.ts as well.
DATABASE_URL=postgresql://ironbark:ironbark@localhost:5544/ironbark

# Required only by ingestion/ai/classify.py. Without it, the classifier exits
# with a message and fabricates nothing. Layers 1, 2 and 4 still run.
ANTHROPIC_API_KEY=sk-ant-...

# --- Deployment (Railway) ---------------------------------------------------
# The container does not read this file. Railway provides DATABASE_URL from the
# Postgres service and injects PORT, and the Dockerfile builds the frontend with
# VITE_API_BASE="" so the browser calls /api on the same origin. Load the data
# once with scripts/load-railway-db.sh.
